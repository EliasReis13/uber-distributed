SERVER_PORT=8001

# KNOWN_SERVERS: URLs dos OUTROS nós (não inclua a própria), separadas por
# vírgula, sem espaço depois da vírgula. Use os IPs reais das máquinas na
# rede local. Se deixar em branco/comentado, assume os demais nós em
# localhost (útil só para testar o cluster inteiro numa única máquina).
KNOWN_SERVERS=http://192.168.0.x:8002,http://192.168.0.x:8003,http://192.168.0.x:8004,http://192.168.0.x:8005,http://192.168.0.x:8006

# HTTP_TIMEOUT: segundos de timeout por chamada a um vizinho (opcional)
HTTP_TIMEOUT=5
